{
  "manifest_version": 3,
  "name": "MULTIGRID Sound",
  "version": "1.15",
  "description": "Lets MULTIGRID's sound mixer reach players inside embedded streams, and sends the page you are on to MULTIGRID as a stream or favorite.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Send to MULTIGRID",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://thisiseames.github.io/multigrid/*",
        "https://multigrid.club/*",
        "https://www.multigrid.club/*",
        "http://localhost:5190/*",
        "http://127.0.0.1:5190/*"
      ],
      "all_frames": false,
      "run_at": "document_start",
      "js": [
        "carry.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "js": [
        "sound.js"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": false,
      "run_at": "document_idle",
      "js": [
        "send.js"
      ]
    }
  ],
  "permissions": [
    "declarativeNetRequest",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "bg.js"
  }
}
